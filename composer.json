{
    "name": "wordpress-dev/rest-api-explorer",
    "description": "Browse, understand, and test all REST endpoints registered on your site.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "RestApiExplorer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RestApiExplorer\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:coverage": "vendor/bin/phpunit --coverage-text",
        "test:coverage-html": "vendor/bin/phpunit --coverage-html coverage",
        "test:docker": "bash setup-phpunit.sh",
        "test:docker:run": "docker compose exec -T phpunit vendor/bin/phpunit",
        "test:docker:coverage": "docker compose exec -T phpunit env XDEBUG_MODE=coverage vendor/bin/phpunit --coverage-text",
        "test:docker:stop": "docker compose down --remove-orphans"
    }
}
